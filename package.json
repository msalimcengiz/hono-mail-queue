{
  "name": "hono-mail-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Email delivery service: Hono API, RabbitMQ priority classes, delayed retries, dead-lettering and a transactional outbox.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "amqplib": "^2.2.0",
    "hono": "^4.13.13",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
